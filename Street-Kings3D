  <button class="alt" onclick="race('free')">Free mode</button>
  <select onchange="S.city=this.value;save()" title="City">${Object.keys(CITIES).map(k=>`<option value="${k}" ${k==(S.city||'green')?'selected':''}>${CITIES[k].n}</option>`).join('')}</select>
  <select onchange="S.wx=this.value;save()" title="Time / weather">${Object.keys(WX).map(k=>`<option value="${k}" ${k==(S.wx||'day')?'selected':''}>${WX[k].n}</option>`).join('')}</select>
  <select onchange="S.way=this.value;save()" title="Free mode traffic"><option value="one" ${(S.way||'one')=='one'?'selected':''}>One-way traffic</option><option value="two" ${S.way=='two'?'selected':''}>Two-way traffic</option></select>
