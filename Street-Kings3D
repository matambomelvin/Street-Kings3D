function scenery(){
  const C=CT(),b=Math.floor((R.pos-200)/SPC);
  sc.forEach((s,k)=>{const n=b+md(k-b,NS);
    if(n!==s.n){s.n=n;const r=hs(n),side=n%2?1:-1;let ty='l';for(const kd of C.kinds){if(r<kd[0]){ty=kd[1];break}}s.ty=ty;
      s.h.visible=ty=='h';s.t.visible=ty=='t';s.l.visible=ty=='l';s.cc.visible=ty=='c';s.pn.visible=ty=='p';s.rk.visible=ty=='r';
      const vi=Math.floor(hs(n+3)*3);s.bd.forEach((q,i)=>q.visible=ty=='b'&&i==vi);
      if(ty=='h'){s.h.userData.wall.material.color.setHex(C.hc[md(n,6)]);s.h.userData.roof.material.color.setHex(C.rf[md(n>>1,4)]);s.h.rotation.y=-side*Math.PI/2}
      if(ty=='b')s.bd[vi].material.color.setHex(C.hc[md(n,6)]);
      if(ty=='r'){s.rk.userData.m.material.color.setHex(C.rk);s.rk.rotation.y=r*6}
      s.l.scale.x=side;
      const off={h:12+r*3,t:5.5+r*3,l:7,b:16+r*3,c:6.5+r*4,p:6+r*3,r:6+r*5}[ty];
      s.g.position.set(side*off+cx(n*SPC),0,-n*SPC);s.g.rotation.y=-hd(n*SPC)}
    if(s.ty=='t')s.t.userData.f1.position.x=Math.sin(R.ck*1.5+n)*.1});
  const pb=Math.floor((R.pos-150)/PSP);
  pp.forEach((o,k)=>{const n=pb+md(k-pb,NP),u=o.p.userData;
    if(n!==o.n){o.n=n;o.p.visible=hs(n+500)>.3;const side=hs(n+99)<.5?-1:1;
      const zz=n*PSP+hs(n+900)*8;o.p.position.set(side*(7.9+hs(n+7)*.8)+cx(zz),0,-zz);o.p.rotation.y=-side*Math.PI/2-hd(zz);
      u.shirt.color.setHex([0xe63946,0x2a9d8f,0xf4a261,0x8d6cc0,0x3a86ff][md(n,5)]);u.skin.color.setHex([0xf1c27d,0xc68642,0x8d5524,0xe0ac69][md(n,4)])}
    if(o.p.visible){const sn=Math.sin(R.ck*7+n*1.7);u.ll.rotation.x=sn*.7;u.rl.rotation.x=-sn*.7;
      if(md(n,3)==0){const a=2.6+Math.sin(R.ck*9+n)*.4;u.la.rotation.z=-a;u.ra.rotation.z=a;u.la.rotation.x=u.ra.rotation.x=0}
      else{u.la.rotation.x=-sn*.6;u.ra.rotation.x=sn*.6;u.la.rotation.z=u.ra.rotation.z=0}
      o.p.position.y=Math.abs(sn)*.05}})}
