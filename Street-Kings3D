  <button onclick="wash()" ${S.money<200||!(S.dirt[id]>0)?'disabled':''}>Wash car $200</button><br>Dirt: ${Math.round((S.dirt[id]||0)*100)}%</div>
  <div class="box"><b>Upgrades</b>${nm.map((n,i)=>`<div>${n} level ${u[i]}/5 <button onclick="upg(${i})" ${u[i]>=5||S.money<cost(u[i])?'disabled':''}>${u[i]>=5?'MAX':fmt(cost(u[i]))}</button></div>`).join('')}
  <small>Top speed ${Math.round(stats(id).top)} km/h</small></div></div>
  <h3>Blacklist: beat all 10 rivals (races start at #10)</h3>
  ${S.rank<1?'<h2 style="color:#ffe066">You are the #1 street king!</h2>':''}
  ${RIV.map((r,i)=>{const rk=10-i;return `<div class="rv ${rk>S.rank?'done':rk==S.rank?'next':''}"><span>#${rk} ${r.n} (${r.car}, ~${r.v} km/h)</span>${rk==S.rank?'<button class="alt" onclick="race(\'bl\')">RACE</button>':''}</div>`}).join('')}
  <h3>Car dealer</h3><div class="grid">${CARS.map(c=>{const o=S.own.includes(c.id);return `<div class="box ${c.id==id?'sel':''}"><b>${c.n}</b><br>Speed ${c.v} | Accel ${c.a} | Grip ${c.g}<br>${o?`<button onclick="S.cur='${c.id}';save();garage()" ${c.id==id?'disabled':''}>${c.id==id?'Driving':'Drive'}</button>`:`<button onclick="buyCar('${c.id}')" ${S.money<c.p?'disabled':''}>Buy ${fmt(c.p)}</button>`}</div>`}).join('')}</div>
  <p>Controls: W/Up = gas, S/Down = brake, A D or Left/Right = steer, Space = nitro, P or Esc = pause, F = full screen, M = music, L = look behind you (press L again to look forward). Pick a city, Day/Night/Rain and One-way/Two-way traffic next to the Free mode button. Free mode has winding roads, side roads with stop signs, toll gates, police roadblocks, traffic, buses, trucks and police: drive over 200 km/h for a few seconds and the police will chase you!</p>`;
  setShow();
}
function buyCar(id){const c=CAR(id);if(S.money<c.p)return;S.money-=c.p;S.own.push(id);S.cur=id;save();garage()}
function upg(i){const u=upOf(S.cur),c=cost(u[i]);if(u[i]>=5||S.money<c)return;S.money-=c;u[i]++;save();garage()}
function wash(){if(S.money<200)return;S.money-=200;S.dirt[S.cur]=0;save();garage()}
