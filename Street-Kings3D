    const kk=kmin+(((j-kmin)%4)+4)%4,u=e.g.userData;
    if(e.k!==kk){e.k=kk;e.z=420*kk;e.type=['block','inter','toll','inter'][kk%4];e.gap=Math.floor(hs(kk+11)*4);e.paid=e.ran=e.open=e.broken=0;e.cd=0;e.last=R.pos;
      e.g.visible=true;u.it.visible=e.type=='inter';u.tl.visible=e.type=='toll';u.bk.visible=e.type=='block';
      e.g.position.set(cx(e.z),0,-e.z);e.g.rotation.y=-hd(e.z);
      u.bars.forEach((b,i)=>b.visible=i!=e.gap);u.arms.forEach(a=>{a.ang=0;a.p.rotation.z=0})}
    const dist=e.z-R.pos;e.cd-=dt;
    if(dist>-60&&dist<260){
      if(e.type=='inter'){
        const tt=R.ck*.4+e.k,x=Math.sin(tt)*70;u.cc.position.set(x,0,0);u.cc.rotation.y=Math.cos(tt)>0?-Math.PI/2:Math.PI/2;
        if(Math.abs(R.pos-e.z)<3.3&&Math.abs(R.px-x)<3.1&&e.cd<=0){e.cd=2;crash('CRASH! You hit a crossing car',250)}
        if(e.last<e.z-7.5&&R.pos>=e.z-7.5&&R.spd>40&&!e.ran){e.ran=1;const f=Math.min(S.money,150);S.money-=f;save();R.al='You ran a stop sign!  -'+fmt(f);R.alT=3}
      }else if(e.type=='toll'){
        if(!e.open&&!e.broken&&dist<45&&dist>0&&R.spd<50)e.open=1;
        const tg=(e.open||e.broken)?1.35:0;u.arms.forEach(a=>{a.ang+=(tg-a.ang)*Math.min(1,dt*6);a.p.rotation.z=a.side*a.ang});
        if(!e.paid&&e.open&&e.last<e.z&&R.pos>=e.z){e.paid=1;const f=Math.min(S.money,50);S.money-=f;save();R.al='Toll paid  -'+fmt(f);R.alT=2.5}
        if(!e.open&&!e.broken&&Math.abs(R.pos-e.z)<2.3&&Math.abs(R.px)<6.4){crash('You crashed into the toll barrier!',100);R.pos=e.z-2.4;R.spd=Math.min(R.spd,8);e.broken=1}
        if(Math.abs(R.pos-e.z)<2.6&&[-3.2,0,3.2].some(bx=>Math.abs(R.px-bx)<1.5)){crash('You hit a toll booth!',150);R.pos=e.z-2.7;R.spd=Math.min(R.spd,6)}
      }else{
        u.lights.forEach(l=>{l[0].color.setHex(fl?0xff3030:0x400808);l[1].color.setHex(fl?0x081840:0x3060ff)});
        const hit=(R.pos>e.z-2.6&&R.pos<e.z+2.6)||(e.last<e.z-2.6&&R.pos>=e.z+2.6);
        if(hit&&Math.abs(R.px)<6.4&&laneIdx(R.px)!=e.gap){crash('You hit the police roadblock!',200);R.pos=e.z-2.7;R.spd=Math.min(R.spd,6);
          if(!R.chase&&R.cool<=0)startChase('Roadblock! Police are after you!')}
      }
    }
    e.last=R.pos})}
function update(dt){
  if(R.done||R.paused)return;
  R.ck+=dt;R.alT-=dt;
  if(R.cd>0){R.cd-=dt;return}
  const st=R.st,up=K.ArrowUp||K.KeyW||K.TG,dn=K.ArrowDown||K.KeyS||K.TB,lf=K.ArrowLeft||K.KeyA||K.TL,rt=K.ArrowRight||K.KeyD||K.TR;
  const wet=S.wx=='rain';
  R.t+=dt;let top=st.top,acc=st.acc;
  const nitro=(K.Space||K.TN)&&R.nit>0;R.nitro=!!nitro;R.brk=!!dn;
  if(nitro){R.nit-=dt*.25;top*=1+.2*st.nit;acc*=2}else R.nit=Math.min(1,R.nit+dt*.03);
  if(Math.abs(R.px)>6.3)top*=.45;
  if(up)R.spd+=acc*12*dt;else R.spd-=25*dt;
  if(dn)R.spd-=(wet?115:160)*dt;
  if(R.spd>top)R.spd-=120*dt;if(R.spd<0)R.spd=0;
  const sv=(rt?1:0)-(lf?1:0);R.sv+=(sv-R.sv)*Math.min(1,dt*8);
  R.px=cl(R.px+sv*dt*8*(.35+R.spd/360)*st.grip*(wet?.85:1),-9.5,9.5);
  R.pos+=R.spd/3.6*dt;R.shake=Math.max(0,R.shake-dt);R.bc=Math.max(0,R.bc-dt);
  if(R.mode=='free'){traffic(dt);events(dt)}
  if(R.riv){const rs=R.riv.v*(.97+.03*Math.sin(R.t*.6));R.rd+=rs/3.6*dt;
    R.rx+=(-2.7+Math.sin(R.t*.5)*2.4-R.rx)*dt*.8;
    const gap=R.rd-R.pos,lat=Math.abs(R.px-R.rx);
    if(Math.abs(gap)<4.8&&lat<2.1){
      const dr=R.px>=R.rx?1:-1;R.px+=dr*dt*8;R.rx-=dr*dt*4;
      if(R.bc<=0){R.shake=.3;R.bc=.5;thud()}
      if(gap>=0){R.pos=R.rd-4.8;R.spd=Math.min(R.spd,rs*.9)}else{R.rd=R.pos-4.8}
    }
    R.px=cl(R.px,-9.5,9.5);R.rx=cl(R.rx,-5.2,5.2);
    if(R.pos>=LEN||R.rd>=LEN)finish(R.pos>=R.rd)}
}
function renderRace(dt){
  const tz=-R.pos;
  if(!R.paused){const w=R.spd/3.6*dt/.34;player.userData.ws.forEach(x=>x.rotation.x-=w);if(rival){const w2=R.riv.v/3.6*dt/.34;rival.userData.ws.forEach(x=>x.rotation.x-=w2)}}
  const pc=cx(R.pos);player.position.set(R.px+pc,0,tz);player.rotation.y=-R.sv*.12-hd(R.pos);player.rotation.z=-R.sv*.03;
  player.userData.tm.forEach(m=>m.emissiveIntensity=R.brk?2.2:.8);
  player.userData.fl.forEach(f=>{f.visible=R.nitro;f.scale.y=.7+Math.random()*.6});
  if(rival){rival.position.set(R.rx,0,-R.rd);rival.rotation.y=-(-2.7+Math.sin(R.t*.5)*2.4-R.rx)*.04}
  let sx=0,sy=0;if(R.shake>0){sx=(Math.random()-.5)*.5;sy=(Math.random()-.5)*.3}
  const back=!!R.back;player.visible=!back;
  if(back){camera.position.set(cx(R.pos-2.6)+R.px*.9+sx,1.9+sy,tz+2.6);camera.lookAt(cx(R.pos-40)+R.px*.9,1.5,tz+40)}
  else{camera.position.set(cx(R.pos-8)+R.px*.85+sx,3.3+sy,tz+8);camera.lookAt(cx(R.pos+14)+R.px*.6,1.2,tz-14)}
  const fv=58+Math.min(R.spd,320)*.04+(R.nitro?7:0);if(Math.abs(camera.fov-fv)>.05){camera.fov+=(fv-camera.fov)*.1;camera.updateProjectionMatrix()}
  const snap=Math.round(R.pos/20)*20;ground.position.z=-snap;updRoad();
  sun.position.set(R.px+25+pc,45,tz+15);sun.target.position.set(R.px+pc,0,tz);
  head.position.set(R.px+pc,1,tz-1.5);head.target.position.set(R.px+cx(R.pos+30),0,tz-30);if(S.wx=='rain')updRain(dt);
  mts.position.z=tz-430;mts2.position.z=tz+430;clouds.forEach((s,i)=>{s.position.z=i%2?tz+380:tz-380;s.position.x=((-300+i*120+R.ck*3+400)%800)-400});
  scenery();
  $('spd').textContent=Math.round(R.spd)+' km/h';$('nit').style.width=(R.nit*100)+'%';
  if(R.riv){const gp=Math.round(R.pos-R.rd);$('rv').textContent='vs #'+S.rank+' '+R.riv.n+': '+(gp>=0?gp+' m ahead':-gp+' m behind');$('prg').style.width=(Math.min(1,R.pos/LEN)*100)+'%'}
  $('cd').innerHTML=R.cd>0?(R.cd>3?'':Math.ceil(R.cd))+'<small>Get ready: hold W or the Up arrow to drive</small>':(R.t<1?'GO!':'');
  if(!R.riv)$('rv').textContent=CT().n+' - Free mode'+(R.chase?'  |  POLICE CHASE!':'');
  $('prg').parentNode.style.display=R.riv?'block':'none';
  $('al').textContent=R.alT>0?R.al:(back?'LOOKING BACK  (press L to look forward)':'');
  renderer.render(RS,camera);
}
function renderShow(dt){
  if(Math.abs(camera.fov-38)>.01){camera.fov=38;camera.updateProjectionMatrix()}
  if(showCar){showCar.rotation.y+=dt*.5;showCar.userData.ws.forEach(w=>w.rotation.x-=dt*2)}
  camera.position.set(6.2,2.4,7.6);camera.lookAt(0,.7,0);renderer.render(SR,camera)}
let last=0;
function loop(t){const dt=Math.min((t-last)/1000||0,.05);last=t;
  if(R){update(dt);renderRace(dt)}else renderShow(dt);
  requestAnimationFrame(loop)}
resize();garage();requestAnimationFrame(loop);
</script>
