const K={};let R=null;
const KM={w:'KeyW',a:'KeyA',s:'KeyS',d:'KeyD',p:'KeyP',q:'KeyQ',f:'KeyF',m:'KeyM',l:'KeyL',' ':'Space'};
const kc=e=>e.code||KM[(e.key||'').toLowerCase()]||e.key;
addEventListener('keydown',e=>{const c=kc(e);K[c]=1;if(['Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight'].includes(c))e.preventDefault();
  if(c=='KeyM'&&!e.repeat)toggleMusic();
  if(!R||e.repeat)return;
  if(c=='KeyL'){R.back=!R.back;return}
  if(c=='KeyF'){fs();return}
  if(c=='Escape'||c=='KeyP'){if(!R.done)pause();return}
