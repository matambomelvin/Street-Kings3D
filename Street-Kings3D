.rv.next{outline:2px solid #ffe066}.rv.done{opacity:.4;text-decoration:line-through}
#wrap{position:relative;width:100%;aspect-ratio:16/9;background:#0b0d12;border-radius:8px;overflow:hidden}
#wrap.gar{aspect-ratio:auto;height:340px}
#wrap:fullscreen{aspect-ratio:auto;width:100vw;height:100vh;border-radius:0}
#wrap:-webkit-full-screen{aspect-ratio:auto;width:100vw;height:100vh;border-radius:0}
#gl{position:absolute;left:0;top:0;width:100%;height:100%;display:block}
#hud{display:none;position:absolute;left:0;top:0;right:0;bottom:0;pointer-events:none;z-index:3}
#hl{position:absolute;left:10px;top:10px;background:rgba(0,0,0,.55);padding:8px 12px;border-radius:8px;min-width:190px}
#spd{font:bold 28px Arial}
.nb{height:9px;background:#333;border-radius:5px;margin-top:5px;overflow:hidden}
.nb i{display:block;height:100%;width:100%;background:#4cc9f0}
#hr{position:absolute;right:10px;top:10px;background:rgba(0,0,0,.55);padding:8px 12px;border-radius:8px;text-align:right;min-width:210px;font-weight:700}
#prg{background:#ff7a3d;width:0}
#cd{position:absolute;left:0;right:0;top:28%;text-align:center;font:bold 90px Impact,sans-serif;color:#ffe066;text-shadow:0 3px 8px #000}
#cd small{display:block;font:bold 22px Arial;color:#fff}
#pm,#end{display:none;position:absolute;left:0;top:0;right:0;bottom:0;background:rgba(0,0,0,.7);flex-direction:column;align-items:center;justify-content:center;gap:8px;z-index:6}
#pm h2,#end h2{font:46px Impact,sans-serif;margin:0 0 8px;color:#ffe066;text-align:center}
#pm button,#end button{width:230px;font-size:18px;padding:12px}
#pz{display:none;position:absolute;top:10px;left:50%;transform:translateX(-50%);z-index:4;background:rgba(0,0,0,.55)}
#fs{display:none;position:absolute;top:10px;left:calc(50% + 74px);z-index:4;background:rgba(0,0,0,.55)}
#pz[style*="block"]~#fs{display:block}
#tc{display:none}
select{background:#171b26;color:#fff;border:1px solid #555;border-radius:7px;padding:8px;font-weight:700}
#al{position:absolute;left:0;right:0;top:16%;text-align:center;font:bold 38px Impact,sans-serif;color:#ff5050;text-shadow:0 2px 8px #000}
.tb{position:absolute;width:72px;height:72px;border-radius:50%;border:2px solid #fff;background:rgba(255,255,255,.22);color:#fff;font:700 14px Arial;touch-action:none;user-select:none;z-index:4;padding:0}
@media (pointer:coarse){#tc.on{display:block}}
</style>
